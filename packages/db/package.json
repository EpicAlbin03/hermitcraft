{
	"name": "@hc/db",
	"private": true,
	"type": "module",
	"exports": {
		"./connection": "./src/connection.ts",
		"./schema": "./src/schema.ts"
	},
	"scripts": {
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"check": "tsc --noEmit",
		"lint": "prettier --ignore-path ../../.prettierignore --check . && eslint .",
		"format": "prettier --ignore-path ../../.prettierignore --write ."
	},
	"devDependencies": {
		"@effect/sql-pg": "catalog:effect",
		"@hc/eslint-config": "workspace:*",
		"@hc/prettier-config": "workspace:*",
		"@hc/ts-config": "workspace:*",
		"@types/bun": "catalog:base",
		"@types/pg": "catalog:db",
		"effect": "catalog:effect",
		"eslint": "catalog:eslint",
		"drizzle-kit": "catalog:db",
		"drizzle-orm": "catalog:db",
		"pg": "catalog:db",
		"prettier": "catalog:prettier",
		"@typescript/native": "catalog:base",
		"typescript": "catalog:base"
	}
}
