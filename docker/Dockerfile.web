FROM oven/bun:1.3.3@sha256:fbf8e67e9d3b806c86be7a2f2e9bae801f2d9212a21db4dcf8cc9889f5a3c9c4 AS base

FROM base AS prune
RUN bun add -g turbo@2.6.1
WORKDIR /app
COPY . .
RUN turbo prune @hc/sv-web --docker

FROM base AS build
WORKDIR /app
COPY --from=prune /app/out/json/ .
COPY --from=prune /app/bun.lock ./bun.lock
RUN bun install
COPY --from=prune /app/out/full/ .
COPY tsconfig.base.json .
RUN bun run --filter @hc/sv-web build

FROM oven/bun:1.3.3-slim@sha256:5d55d9702e1c634a931f048d0ec84d35583450d6059327cb88d82edd55068556 AS runtime
WORKDIR /app
COPY --from=build /app/apps/sv-web/build ./build
COPY --from=build /app/node_modules ./node_modules
EXPOSE 8080
ENV PORT=8080
CMD ["bun", "run", "build/index.js"]
