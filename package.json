{
  "name": "@hc/root",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:destroy": "docker compose down -v",
    "redis:connect": "docker exec -it hc-redis redis-cli",
    "postgres:connect": "docker exec -it hc-postgres psql -U postgres -d hc-postgres",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "prepare": "effect-language-service patch",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.turbo packages/*/.turbo"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "base": {
        "@types/bun": "^1.3.14",
        "typescript": "^5.9.3"
      },
      "effect": {
        "@effect/language-service": "^0.86.2",
        "@effect/platform-bun": "^0.89.0",
        "effect": "^3.21.2"
      },
      "eslint": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.17.0",
        "eslint-config-turbo": "^2.9.16",
        "globals": "^17.4.0",
        "typescript-eslint": "^8.58.1"
      },
      "prettier": {
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.0.1",
        "prettier-plugin-tailwindcss": "^0.8.0"
      },
      "db": {
        "@effect/sql-pg": "^0.52.1",
        "@types/pg": "^8.15.6",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "pg": "^8.20.0"
      },
      "content-sync": {
        "@twurple/api": "^8.1.4",
        "@twurple/auth": "^8.1.4",
        "googleapis": "^164.1.0",
        "sharp": "^0.34.5",
        "thumbhash": "^0.1.1"
      },
      "svelte": {
        "@fontsource-variable/geist": "^5.2.9",
        "@internationalized/date": "^3.12.0",
        "@lucide/svelte": "^1.16.0",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/enhanced-img": "^0.10.4",
        "@sveltejs/kit": "^2.57.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.2",
        "bits-ui": "^2.16.3",
        "clsx": "^2.1.1",
        "mdsvex": "^0.12.7",
        "mode-watcher": "^1.1.0",
        "runed": "^0.37.1",
        "shadcn-svelte": "^1.2.7",
        "svelte": "^5.55.2",
        "svelte-check": "^4.4.8",
        "tailwind-merge": "^3.5.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.2.2",
        "tw-animate-css": "^1.4.0",
        "vite": "^8.0.7"
      }
    }
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  }
}
