{
	"name": "@hc/root",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@effect/language-service": "^0.86.1",
			"@effect/platform-bun": "4.0.0-beta.68",
			"@types/bun": "^1.3.14",
			"@typescript/native-preview": "^7.0.0-dev.20260421.2",
			"drizzle-orm": "1.0.0-rc.2",
			"effect": "4.0.0-beta.68",
			"prettier": "^3.8.3",
			"typescript": "npm:@typescript/typescript6@^6.0.1"
		}
	},
	"scripts": {
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:destroy": "docker compose down -v",
		"redis:connect": "docker exec -it hc-redis redis-cli",
		"postgres:connect": "docker exec -it hc-postgres psql -U postgres -d hc-postgres",
		"check": "turbo run check",
		"lint": "turbo run lint",
		"format": "prettier --write .",
		"check-types": "turbo run check-types",
		"prepare": "effect-tsgo patch",
		"clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.turbo packages/*/.turbo"
	},
	"patchedDependencies": {
		"@typescript/typescript6@6.0.1": "patches/@typescript%2Ftypescript6@6.0.1.patch"
	},
	"devDependencies": {
		"@effect/language-service": "catalog:",
		"@effect/tsgo": "0.11.0",
		"@types/bun": "catalog:",
		"@typescript/native-preview": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "^4.0.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"turbo": "^2.9.14",
		"typescript": "catalog:"
	}
}
