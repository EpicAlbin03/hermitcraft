{
  "name": "@hc/root",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:destroy": "docker compose down -v",
    "redis:connect": "docker exec -it hc-redis redis-cli",
    "postgres:connect": "docker exec -it hc-postgres psql -U postgres -d hc-postgres",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "prepare": "effect-tsgo patch",
    "clean": "bash -lc \"find . -type d \\( -name node_modules -o -name build -o -name .turbo -o -name .tsbuildinfo -o -name .svelte-kit \\) -exec rm -rf {} +\""
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "base": {
        "@types/bun": "^1.3.14",
        "@typescript/native": "npm:typescript@7.0.2",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "turbo": "^2.10.5"
      },
      "effect": {
        "@effect/platform-bun": "^4.0.0-beta.99",
        "@effect/sql-pg": "^4.0.0-beta.99",
        "@effect/tsgo": "0.24.1",
        "effect": "^4.0.0-beta.99"
      },
      "eslint": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.20.0",
        "eslint-config-turbo": "^2.10.5",
        "globals": "^17.7.0",
        "typescript-eslint": "^8.64.0"
      },
      "prettier": {
        "prettier": "^3.9.5",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1"
      },
      "db": {
        "@types/pg": "^8.20.0",
        "drizzle-kit": "^1.0.0-rc.4",
        "drizzle-orm": "^1.0.0-rc.4",
        "pg": "^8.22.0"
      },
      "content-sync": {
        "@twurple/api": "^8.1.4",
        "@twurple/auth": "^8.1.4",
        "fast-xml-parser": "^5.10.1",
        "googleapis": "^173.0.0",
        "sharp": "^0.35.3",
        "thumbhash": "^0.1.1"
      },
      "svelte": {
        "@fontsource-variable/geist": "^5.2.9",
        "@internationalized/date": "^3.12.2",
        "@lucide/svelte": "^1.25.0",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/enhanced-img": "^0.11.0",
        "@sveltejs/kit": "^2.70.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "bits-ui": "^2.18.1",
        "clsx": "^2.1.1",
        "mdsvex": "^0.12.7",
        "mode-watcher": "^1.1.0",
        "runed": "^0.37.1",
        "shadcn-svelte": "^1.4.2",
        "svelte": "^5.56.6",
        "svelte-check": "^4.7.3",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vite": "^8.1.5"
      }
    }
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:effect",
    "@typescript/native": "catalog:base",
    "turbo": "catalog:base",
    "typescript": "catalog:base"
  }
}
